"""Run using FreeCAD's Python, or open as a macro in FreeCAD.

Every document includes a parameter spreadsheet with provenance. All dimensions
are illustrative until measured. No mounting holes or load ratings are invented.
"""
from pathlib import Path
import json, sys, math
import FreeCAD as App
import Part
BASE=Path(__file__).resolve().parent
CFG=json.loads((BASE/'dimensions.json').read_text())
OUT=BASE/'exports'; OUT.mkdir(exist_ok=True)
COL={'chassis':(0.22,0.27,0.32),'tyre':(.10,.12,.14),'cart':(.25,.29,.27),'metal':(.65,.70,.74),'dock':(.08,.35,.85),'enclosure':(.94,.35,.10),'board':(.10,.60,.40)}
meshes={}; checks=[]
def newdoc(name):
    d=App.newDocument(name);s=d.addObject('Spreadsheet::Sheet','Parameters');s.set('A1','R1 LAYOUT PROXIES / UNVERIFIED SOURCE SPECS - NOT MEASURED')
    s.set('A2','parameter');s.set('B2','layout_mm');s.set('C2','measured_mm');s.set('D2','source / status')
    for row,(k,v) in enumerate(CFG['parameters'].items(),3):
        s.set('A'+str(row),k);s.set('B'+str(row),str(v['layout_mm']));s.setAlias('B'+str(row),k);s.set('C'+str(row),'UNKNOWN');s.set('D'+str(row),v.get('source','Illustrative layout choice, not a measured or manufacturer dimension'))
    d.recompute();return d
def expr(o,prop,val):o.setExpression(prop,str(val))
def box(d,name,L,W,H,x,y,z,color):
    o=d.addObject('Part::Box',name)
    for prop,val in zip(['Length','Width','Height','Placement.Base.x','Placement.Base.y','Placement.Base.z'],[L,W,H,x,y,z]):expr(o,prop,val)
    o.addProperty('App::PropertyString','EvidenceStatus');o.EvidenceStatus='PROPOSED - illustrative geometry; measure before use'
    o.addProperty('App::PropertyString','ReviewNote');o.ReviewNote='R1: Pi model unresolved; range sensor reported lost. No hole pattern, tolerance or strength qualification'
    if App.GuiUp:o.ViewObject.ShapeColor=COL[color]
    o.addProperty('App::PropertyString','DraftColor');o.DraftColor=color
    return o
def cyl(d,name,R,H,x,y,z,color):
    o=d.addObject('Part::Cylinder',name);o.Placement.Rotation=App.Rotation(App.Vector(1,0,0),90)
    for prop,val in zip(['Radius','Height','Placement.Base.x','Placement.Base.y','Placement.Base.z'],[R,H,x,y,z]):expr(o,prop,val)
    o.addProperty('App::PropertyString','EvidenceStatus');o.EvidenceStatus='PROPOSED - unmeasured envelope'
    o.addProperty('App::PropertyString','DraftColor');o.DraftColor=color
    if App.GuiUp:o.ViewObject.ShapeColor=COL[color]
    return o
def shell(d,name,L,W,H,x,y,z,color,wall='Parameters.wall'):
    a=box(d,name+'Outer',L,W,H,x,y,z,color)
    b=box(d,name+'Void',f'({L})-2*({wall})',f'({W})-2*({wall})',H,f'({x})+({wall})',f'({y})+({wall})',f'({z})+({wall})',color)
    cut=d.addObject('Part::Cut',name);cut.Base=a;cut.Tool=b;cut.addProperty('App::PropertyString','DraftColor');cut.DraftColor=color
    cut.addProperty('App::PropertyString','EvidenceStatus');cut.EvidenceStatus='R1 PROPOSED open shell; nominal enclosure source spec is unverified; actual moulded profile unknown'
    if App.GuiUp:a.ViewObject.Visibility=False;b.ViewObject.Visibility=False;cut.ViewObject.ShapeColor=COL[color]
    return cut
def finish(d,objects):
    d.recompute()
    for o in objects:
        assert not o.Shape.isNull() and o.Shape.isValid(),o.Name
        checks.append({'document':d.Name,'object':o.Name,'valid':o.Shape.isValid(),'volume_mm3':o.Shape.Volume,'dimension_status':'illustrative'})
    d.saveAs(str(BASE/(d.Name+'.FCStd')))
    Part.export(objects,str(OUT/(d.Name+'.step')))
    items=[]
    for o in objects:
        verts,tris=o.Shape.tessellate(2)
        items.append({'name':o.Name,'color':COL[o.DraftColor],'vertices':[[v.x,v.y,v.z] for v in verts],'triangles':tris})
    meshes[d.Name]=items
    # Reopen native file and STEP independently, not just the in-memory shape.
    name=d.Name;App.closeDocument(name);r=App.openDocument(str(BASE/(name+'.FCStd')))
    assert r.Objects;App.closeDocument(r.Name)
    step=Part.Shape();step.read(str(OUT/(name+'.step')));assert not step.isNull() and step.isValid(),name

def mount(d):
    return [box(d,'LongMember'+str(i),500,22,22,-250,y,'Parameters.mount_z-22','metal') for i,y in enumerate([-110,88])]+[box(d,'CrossMember'+str(i),22,280,22,x,-140,'Parameters.mount_z-44','metal') for i,x in enumerate([-200,178])]
def dock(d,x=0,y=0,z=0):
    return [box(d,'DockEnvelope','Parameters.dock_length','Parameters.dock_width','Parameters.dock_height',x,y,z,'dock'),box(d,'SlideRailA','Parameters.dock_length',8,8,x,y+8,z+25,'chassis'),box(d,'SlideRailB','Parameters.dock_length',8,8,x,y+64,z+25,'chassis')]
def enclosure(d,x=0,y=0,z=0):
    return [shell(d,'Enclosure','Parameters.enclosure_length','Parameters.enclosure_width','Parameters.enclosure_height',str(x),str(y),str(z),'enclosure'),box(d,'PiEnvelope',85,56,18,x+12,y+12,z+10,'board'),box(d,'UnoR3Envelope',69,54,15,x+114,y+12,z+10,'board')]
def sensors(d,x=0,y=0,z=0):
    return [box(d,'SensorBracket',60,30,4,x,y,z,'metal'),box(d,'UltrasonicBoard',46,20,2,x+7,y+5,z+4,'board'),cyl(d,'TransducerA',8,12,x+18,y+8,z+16,'metal'),cyl(d,'TransducerB',8,12,x+42,y+8,z+16,'metal')]

d=newdoc('v2_cart_mount');finish(d,mount(d))
d=newdoc('v2_battery_mount');finish(d,dock(d))
d=newdoc('v2_electronics_enclosure');finish(d,enclosure(d))
d=newdoc('v2_sensor_mounts');finish(d,sensors(d))
d=newdoc('v2_assembly');objects=[]
for i,y in enumerate(['-Parameters.rail_spacing/2-6','Parameters.rail_spacing/2-6']):objects.append(box(d,'ChassisRail'+str(i),'Parameters.rail_length',12,32,'-Parameters.rail_length/2',y,'Parameters.chassis_z','chassis'))
for ax,x in enumerate(['-Parameters.wheelbase/2','Parameters.wheelbase/2']):
    objects.append(cyl(d,'Axle'+str(ax),12,'Parameters.track_centres',x,'Parameters.track_centres/2','Parameters.tyre_radius','chassis'))
    for side,y in enumerate(['-Parameters.track_centres/2+Parameters.tyre_width/2','Parameters.track_centres/2+Parameters.tyre_width/2']):objects.append(cyl(d,'Tyre'+str(ax)+str(side),'Parameters.tyre_radius','Parameters.tyre_width',x,y,'Parameters.tyre_radius','tyre'))
    for side,y in enumerate([-100,100]):
        shock=cyl(d,'CoiloverEnvelope'+str(ax)+str(side),9,80,x,y,110,'metal');shock.Placement.Rotation=App.Rotation();objects.append(shock)
objects+=mount(d)
objects.append(shell(d,'CartTub','Parameters.cart_length','Parameters.cart_width','Parameters.cart_height','-Parameters.cart_length/2','-Parameters.cart_width/2','Parameters.mount_z','cart'))
objects+=enclosure(d,-105,110,175)
objects+=dock(d,-55,-170,205)
objects+=sensors(d,300,-15,210)
finish(d,objects)
(OUT/'review-meshes.json').write_text(json.dumps(meshes),encoding='utf-8')
(OUT/'geometry-checks.json').write_text(json.dumps({'FreeCAD_version':App.Version(),'checks':checks,'note':'Geometric validity only. Illustrative layout; no measured fit, travel or structural validation.'},indent=2),encoding='utf-8')
print('Five FCStd and STEP files saved, reopened and geometrically checked.')
