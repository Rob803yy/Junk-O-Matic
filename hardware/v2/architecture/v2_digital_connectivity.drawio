        </mxCell>
        <mxCell id="out" value="Local feedback candidate&#10;LED resistor / buzzer drive TBD&#10;Pins / threshold unassigned&#10;Outputs default OFF&#10;[PROPOSED]" style="rounded=1;whiteSpace=wrap;html=0;align=left;spacing=12;fontSize=16;fillColor=#ffffff;strokeColor=#7251a3;" vertex="1" parent="1">
