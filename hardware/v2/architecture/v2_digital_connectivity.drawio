        <mxCell id="pi" value="Pi model unresolved&#10;Pi 3B vs Pi 4 source conflict&#10;USB host serial proposed&#10;No GPIO or RC control assumed&#10;[CONFLICTING]" style="rounded=1;whiteSpace=wrap;html=0;align=left;spacing=12;fontSize=16;fillColor=#ffffff;strokeColor=#b33a3a;" vertex="1" parent="1">
          <mxGeometry x="40" y="150" width="370" height="160" as="geometry" />
        </mxCell>
        <mxCell id="uno" value="Elegoo Uno R3&#10;Owner confirms board identity&#10;USB serial, 115200 proposed&#10;Existing running software unknown&#10;[CONFIRMED]" style="rounded=1;whiteSpace=wrap;html=0;align=left;spacing=12;fontSize=16;fillColor=#ffffff;strokeColor=#216e4e;" vertex="1" parent="1">
          <mxGeometry x="560" y="150" width="370" height="160" as="geometry" />
        </mxCell>
        <mxCell id="imu" value="MPU-6050 candidate&#10;I2C SDA=A4 / SCL=A5 on Uno&#10;Breakout / supply / pullups TBD&#10;Driver default OFF&#10;[PROPOSED]" style="rounded=1;whiteSpace=wrap;html=0;align=left;spacing=12;fontSize=16;fillColor=#ffffff;strokeColor=#7251a3;" vertex="1" parent="1">
          <mxGeometry x="1100" y="150" width="350" height="160" as="geometry" />
        </mxCell>
        <mxCell id="range" value="Historical HC-SR04 profile&#10;Reported lost in S06&#10;Trigger / echo pins unassigned&#10;Driver default OFF&#10;[CONFLICTING]" style="rounded=1;whiteSpace=wrap;html=0;align=left;spacing=12;fontSize=16;fillColor=#ffffff;strokeColor=#b33a3a;" vertex="1" parent="1">
          <mxGeometry x="560" y="490" width="370" height="170" as="geometry" />
        </mxCell>
        <mxCell id="uart" value="Replacement candidate&#10;A02YYUW / SEN0311 proposed&#10;UART 9600; different protocol&#10;OPEN: no driver / pins selected&#10;[PROPOSED]" style="rounded=1;whiteSpace=wrap;html=0;align=left;spacing=12;fontSize=16;fillColor=#ffffff;strokeColor=#7251a3;" vertex="1" parent="1">
