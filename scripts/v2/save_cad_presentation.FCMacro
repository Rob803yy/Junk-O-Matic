import FreeCAD as App,FreeCADGui as Gui,json,traceback
from pathlib import Path
R=Path(__file__).resolve().parents[2]
import importlib.util
spec=importlib.util.spec_from_file_location('cad_components',R/'hardware/v2/mechanical/model_components.py');mod=importlib.util.module_from_spec(spec);spec.loader.exec_module(mod);colors=mod.COL
receipt=[]
try:
    Gui.getMainWindow().hide()
    for p in (R/'hardware/v2/mechanical').glob('*.FCStd'):
        d=App.openDocument(str(p))
        for row,(key,item) in enumerate(mod.CFG['parameters'].items(),3):d.Parameters.set('E'+str(row),item['source'])
        frame=d.getObject('FixedCartFrame')
        if frame:
            if 'MemberOrdering' not in frame.PropertiesList:frame.addProperty('App::PropertyString','MemberOrdering','Review evidence')
            frame.MemberOrdering='CAD-U07: fore/aft members below gray frame; transverse crossmember above. Numeric joint planes/sections/attachments unmeasured.'
            frame.AppearanceEvidence='CAD-P04;CAD-P06;CAD-U06;CAD-U07'
        for o in d.Objects:
            if o.ViewObject and hasattr(o,'ReviewRole'):
                if o.Name.startswith('Historical') or o.Name=='UnselectedSensorReference':o.AppearanceEvidence='S06 historical description; not observed in CAD-P01..03'
                o.ViewObject.Visibility=o.ReviewRole=='render'
                if hasattr(o.ViewObject,'ShapeColor'):
                    o.ViewObject.ShapeColor=colors[o.DraftColor];o.ViewObject.LineColor=(.07,.08,.09)
                    o.ViewObject.Transparency=int((1-o.ReviewOpacity)*100)
                    if hasattr(o.ViewObject,'DisplayMode'):o.ViewObject.DisplayMode='Flat Lines'
        view=Gui.activeDocument().activeView();view.viewAxonometric()
        if p.stem=='v2_assembly':view.setCameraOrientation(App.Rotation(App.Vector(1,1,0),App.Vector(-1,1,2),App.Vector(1,-1,1),'ZXY').Q)
        view.fitAll()
        d.recompute();d.save();receipt.append({'file':p.name,'native_gui_presentation_saved':True});App.closeDocument(d.Name)
    (R/'reports/v2/cad-presentation.json').write_text(json.dumps(receipt,indent=2))
except Exception:
    (R/'reports/v2/cad-presentation-error.txt').write_text(traceback.format_exc())
Gui.getMainWindow().close()
